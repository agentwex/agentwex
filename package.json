{
  "name": "agentwex-repository",
  "version": "0.6.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm test && npm run build",
    "demo": "node exchange/knowledge-exchange-v0.1/demo.mjs",
    "release": "node scripts/build-release.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:lifecycle": "node scripts/smoke-live-lifecycle.mjs --live",
    "lab:route": "node scripts/route-lab.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.45",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  }
}
